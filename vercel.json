{
  "headers": [
    {
      "source": "/pianoman/",
      "headers": [{ "key": "Link", "value": "<https://ericmejias.es/pianoman/>; rel=\"canonical\"" }]
    },
    {
      "source": "/primero/",
      "headers": [{ "key": "Link", "value": "<https://ericmejias.es/primero/>; rel=\"canonical\"" }]
    },
    {
      "source": "/primero/room/:path*",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
    },
    {
      "source": "/primero/game/:path*",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
    }
  ],
  "redirects": [
    {
      "source": "/pianoman/index.html",
      "destination": "/pianoman/",
      "permanent": true
    },
    {
      "source": "/primero/index.html",
      "destination": "/primero/",
      "permanent": true
    },
    {
      "source": "/pianoman",
      "destination": "/pianoman/",
      "permanent": true
    },
    {
      "source": "/primero",
      "destination": "/primero/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/pianoman/",
      "destination": "https://pianoman-eriquito00.vercel.app/index.html"
    },
    {
      "source": "/pianoman/:path*",
      "destination": "https://pianoman-eriquito00.vercel.app/:path*"
    },
    {
      "source": "/primero/",
      "destination": "https://primero-tzxm.onrender.com/index.html"
    },
    {
      "source": "/primero/:path*",
      "destination": "https://primero-tzxm.onrender.com/:path*"
    }
  ]
}
